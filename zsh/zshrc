# ~/.zshrc — managed in ~/code/dotfiles (symlinked). Machine-specific stuff → ~/.zshrc.local

# Powerlevel10k instant prompt (keep near the top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh (theme is loaded from Homebrew below)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git rails)
source "$ZSH/oh-my-zsh.sh"

# Prompt
source "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Suggestions from history as you type (→ to accept)
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Ruby
eval "$(rbenv init - zsh)"

# User binaries (Claude Code native install, pipx, etc.)
export PATH="$HOME/.local/bin:$PATH"

# Optional tools
[[ -f ~/.openclaw/completions/openclaw.zsh ]] && source ~/.openclaw/completions/openclaw.zsh

# Untracked, per-machine overrides (tokens, experiments…)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Must stay last
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
